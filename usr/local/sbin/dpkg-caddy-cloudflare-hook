#!/bin/bash
# dpkg-caddy-cloudflare-hook
#
# Puts the Cloudflare DNS module back into Caddy after the caddy package replaced
# /usr/bin/caddy with the stock binary - before Caddy is started again. When the module
# cannot be added, it puts the previous binary (with the module) back so that Caddy keeps
# running, and tries again later.
#
# Installed as /usr/local/sbin/dpkg-caddy-cloudflare-hook (mode 755) and called from
# /etc/dpkg/dpkg.cfg.d/dpkg-caddy-cloudflare-hook before (--pre-invoke) and after
# (--post-invoke, also the default without an option) every dpkg run, and with --retry
# from dpkg-caddy-cloudflare-hook-retry.timer while a fallback is active. Its state lives
# in /var/lib/dpkg-caddy-cloudflare-hook.
#
# Timing: apt runs "dpkg --unpack" and "dpkg --configure" as separate dpkg runs
# (apt-pkg/deb/dpkgpm.cc: "Do all actions with the same Op in one run"), and Caddy's
# postinst restarts the service only in the configure run (caddyserver/dist,
# scripts/postinstall.sh: try-restart on upgrade). After the unpack run the stock binary
# is on disk while the old Caddy process still runs; this hook adds the module there and
# leaves the restart to the postinst. With a direct "dpkg -i" both steps are one run, the
# package is already configured when the hook runs, and the hook restarts Caddy itself.
#
# The fallback: dpkg runs pre-invoke hooks before the action and post-invoke hooks after
# it (src/main/main.c, run_invoke_hooks around cipaction->action). Before a run that
# unpacks or installs, the pre-invoke step saves /usr/bin/caddy as caddy.previous if it
# has the module. When the post-invoke step cannot add the module in ADD_PACKAGE_ATTEMPTS
# attempts, it keeps the stock binary as caddy.stock, puts caddy.previous back, writes the
# marker "pending" and enables the retry timer. dpkg still counts the new package version
# as installed, so apt will not offer it again; the timer runs this script with --retry
# every 5 minutes, which adds the module to caddy.stock, puts the result in place,
# restarts Caddy and disables the timer again. /etc/update-motd.d/90-dpkg-caddy-cloudflare-hook
# shows the marker at login.
#
# It never exits non-zero: dpkg aborts when an invoke hook fails (run_invoke_hooks).
# Problems are reported on stderr (visible in the apt output and /var/log/apt/term.log)
# and in the journal (journalctl -t dpkg-caddy-cloudflare-hook).
#
# Behaviour of the caddy commands, read in the Caddy source (v2.11.7, cmd/packagesfuncs.go):
# - "caddy list-modules" prints one module ID per line. With "--packages" a line is
#   "<id> <package>", so an exact match on the package path never hits; the module ID
#   is compared instead.
# - "caddy add-package" fails with "package is already added" when the plugin is there.
#   Otherwise it asks caddyserver.com for a build of the latest Caddy with all current
#   plugins plus the new one and replaces the binary it runs from (os.Executable). The
#   hook therefore runs it on a copy in its work directory and puts the result into place
#   with one rename, after checking that the module is there. The downloaded version can
#   be newer than the one apt installed, and dpkg's checksum for /usr/bin/caddy no longer
#   matches; both are accepted.
# - "caddy upgrade" would pin every plugin to the version it has (path@version), so the
#   retry adds the module to the stock binary again instead.
# - The download is a plain http.Get without any timeout (line 298), and Caddy's build
#   server comes without an SLA (caddyserver/caddy#7010). It did not answer for hours on
#   2026-10-23, so every call is limited here; otherwise it would hold the whole dpkg run.
#   With a working build server it took 0.7 to 1.7 s in CI; the retries outside dpkg get
#   more time in case a first build after a new Caddy release takes longer.

set -u

VERSION="1.2.0"
TAG="dpkg-caddy-cloudflare-hook"
PLUGIN_PACKAGE="github.com/caddy-dns/cloudflare"
MODULE_ID="dns.providers.cloudflare"
SERVICE="caddy"
TIMER="dpkg-caddy-cloudflare-hook-retry.timer"
CADDY_BIN="${CADDY_BIN:-/usr/bin/caddy}"
STATE_DIR="${HOOK_STATE_DIR:-/var/lib/dpkg-caddy-cloudflare-hook}"
ADD_PACKAGE_TIMEOUT="${ADD_PACKAGE_TIMEOUT:-30}"     # per attempt during a dpkg run
ADD_PACKAGE_ATTEMPTS="${ADD_PACKAGE_ATTEMPTS:-3}"    # attempts during a dpkg run
ATTEMPT_PAUSE="${ATTEMPT_PAUSE:-5}"                  # seconds between those attempts
RETRY_TIMEOUT="${RETRY_TIMEOUT:-300}"                # per attempt from the timer or by hand

PREVIOUS="$STATE_DIR/caddy.previous"   # last binary with the module, saved before dpkg replaced it
STOCK="$STATE_DIR/caddy.stock"         # the package's binary while the previous one runs instead
PENDING="$STATE_DIR/pending"           # present while the previous binary runs instead
WORK="$STATE_DIR/work"                 # caddy add-package runs here, on a copy
LOCK="$STATE_DIR/lock"                 # keeps a timer run and a dpkg run apart

case "${1:-}" in
    --version)
        printf '%s %s\n' "$TAG" "$VERSION"
        exit 0
        ;;
    --pre-invoke)
        mode="pre"
        ;;
    --post-invoke | "")
        mode="post"
        ;;
    --retry)
        mode="retry"
        ;;
    *)
        printf '%s: unknown option %s (expected --pre-invoke, --post-invoke, --retry or --version)\n' "$TAG" "$1" >&2
        exit 2
        ;;
esac

# Run from the timer, the journal gets the messages through logger only; the service's
# own stderr would put every line there a second time.
to_stderr=1
if [ "$mode" = "retry" ] && [ ! -t 2 ]
then
    to_stderr=0
fi

say()
{
    if [ "$to_stderr" -eq 1 ]
    then
        printf '%s: %s\n' "$TAG" "$*" >&2
    fi
    logger -t "$TAG" -p user.notice -- "$*" 2>/dev/null || true
}

note()
{
    logger -t "$TAG" -p user.notice -- "$*" 2>/dev/null || true
}

warn()
{
    if [ "$to_stderr" -eq 1 ]
    then
        printf '%s: ERROR: %s\n' "$TAG" "$*" >&2
    fi
    logger -t "$TAG" -p user.err -- "ERROR: $*" 2>/dev/null || true
}

fail()
{
    warn "$@"
    exit 0
}

has_module()
{
    "${1:-$CADDY_BIN}" list-modules 2>/dev/null \
        | awk -v id="$MODULE_ID" '$1 == id { found = 1 } END { exit !found }'
}

binary_version()
{
    "$1" version 2>/dev/null | awk 'NR == 1 { print $1 }'
}

# Copies $1 to $2 through a sibling file and a rename, so $2 is never half written.
place_copy()
{
    local src="$1" dst="$2"
    local new="$dst.$TAG-new"

    if cp --preserve=mode,ownership -- "$src" "$new" \
        && { sync -- "$new" 2>/dev/null || sync; } \
        && mv -f -- "$new" "$dst"
    then
        return 0
    fi

    rm -f -- "$new"
    return 1
}

write_pending()
{
    local new="$PENDING.$TAG-new"

    if printf '%s\n' "$1" > "$new" \
        && { sync -- "$new" 2>/dev/null || sync; } \
        && mv -f -- "$new" "$PENDING"
    then
        return 0
    fi

    rm -f -- "$new"
    warn "could not write $PENDING, so there will be no automatic retry; run $TAG by hand later"
    return 1
}

start_retries()
{
    if systemctl enable --now "$TIMER" >/dev/null 2>&1
    then
        return 0
    fi

    warn "could not enable $TIMER (no systemd?), so there are no automatic retries; run $TAG --retry by hand"
    return 1
}

stop_retries()
{
    systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
}

# Ends a fallback: the marker goes (and with it the login notice), the timer stops.
clear_pending()
{
    if [ -f "$PENDING" ]
    then
        rm -f -- "$PENDING"
        stop_retries
    fi
    rm -f -- "$STOCK"
}

# Runs caddy add-package on a copy of $1, limited to $2 seconds. On success the result is
# $WORK/caddy and has the module; otherwise $reason says why. The caller removes $WORK.
build_with_module()
{
    local src="$1" limit="$2" output rc

    rm -rf -- "$WORK"
    if ! mkdir -p -- "$WORK" || ! cp --preserve=mode,ownership -- "$src" "$WORK/caddy"
    then
        reason="could not copy $src to $WORK"
        return 1
    fi

    output="$(timeout --kill-after=10 "$limit" "$WORK/caddy" add-package "$PLUGIN_PACKAGE" 2>&1)"
    rc=$?

    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]
    then
        reason="caddy add-package did not finish within $limit s (is caddyserver.com answering?)"
        return 1
    fi

    if [ "$rc" -ne 0 ]
    then
        reason="caddy add-package failed: $(printf '%s\n' "$output" | tail -n 5)"
        return 1
    fi

    if ! has_module "$WORK/caddy"
    then
        reason="module $MODULE_ID still missing after caddy add-package"
        return 1
    fi

    return 0
}

service_in_use()
{
    systemctl is-enabled --quiet "$SERVICE" 2>/dev/null \
        || systemctl is-active --quiet "$SERVICE" 2>/dev/null \
        || systemctl is-failed --quiet "$SERVICE" 2>/dev/null
}

# Before the postinst ran, it restarts Caddy itself; afterwards the hook does it, but only
# for a service that is in use.
restart_after_change()
{
    if [ "$configured" -eq 0 ]
    then
        say "caddy is not configured yet, its postinst will restart the service"
        return 0
    fi

    if ! service_in_use
    then
        return 0
    fi

    if ! systemctl restart "$SERVICE"
    then
        warn "systemctl restart $SERVICE failed, see: journalctl -u $SERVICE -n 50"
        return 1
    fi

    if ! systemctl is-active --quiet "$SERVICE"
    then
        warn "$SERVICE is not active after the restart, see: journalctl -u $SERVICE -n 50"
        return 1
    fi

    say "$SERVICE restarted"
}

# Puts the result of build_with_module into place and ends a pending fallback.
install_built()
{
    if ! place_copy "$WORK/caddy" "$CADDY_BIN"
    then
        rm -rf -- "$WORK"
        warn "could not put the new binary into $CADDY_BIN"
        return 1
    fi

    rm -rf -- "$WORK"
    clear_pending
    say "module added, binary is now: $(binary_version "$CADDY_BIN")"
    restart_after_change
}

# The module could not be added to the stock binary that dpkg just installed ($1 says why).
fall_back()
{
    local why="$1" package_version previous_version

    if [ ! -f "$PREVIOUS" ] || ! has_module "$PREVIOUS"
    then
        fail "$why; there is no saved binary with the module to fall back to"
    fi

    package_version="$(dpkg-query -W -f='${Version}' caddy 2>/dev/null)"

    if ! place_copy "$CADDY_BIN" "$STOCK"
    then
        fail "$why; could not keep the stock binary as $STOCK, so the previous binary was not put back"
    fi

    if ! place_copy "$PREVIOUS" "$CADDY_BIN"
    then
        rm -f -- "$STOCK"
        fail "$why; could not put $PREVIOUS back into $CADDY_BIN"
    fi

    previous_version="$(binary_version "$CADDY_BIN")"
    write_pending "caddy package $package_version is installed, but the previous binary $previous_version runs because the Cloudflare module could not be added"
    warn "$why; put the previous binary ($previous_version, with the module) back, so caddy $package_version from the package does not run yet. dpkg counts $package_version as installed and apt will not offer it again; $TIMER tries again every 5 minutes, or run $TAG --retry"
    start_retries
    restart_after_change
}

# During a fallback: is the previous binary still the one in place, and is the stock binary
# there to retry with? Ends the fallback or the retries when not.
fallback_intact()
{
    if [ ! -f "$PREVIOUS" ] || ! cmp -s -- "$CADDY_BIN" "$PREVIOUS"
    then
        say "$CADDY_BIN changed since the fallback (replaced by hand?), no more retries"
        clear_pending
        return 1
    fi

    if [ ! -f "$STOCK" ]
    then
        warn "the kept stock binary $STOCK is gone, so there is nothing to retry with; run: apt install --reinstall caddy"
        stop_retries
        return 1
    fi

    return 0
}

# The previous binary runs instead of the package's: add the module to the stock binary.
retry_pending()
{
    if ! fallback_intact
    then
        return 0
    fi

    say "$VERSION: $(cat -- "$PENDING" 2>/dev/null); adding $PLUGIN_PACKAGE to the stock binary again"

    if ! build_with_module "$STOCK" "$RETRY_TIMEOUT"
    then
        rm -rf -- "$WORK"
        warn "$reason; the previous binary keeps running, $TIMER tries again in 5 minutes"
        return 0
    fi

    install_built
}

# Waits for a running timer retry (dpkg runs) or gives way to a dpkg run (timer). Without
# flock (util-linux) the runs are not kept apart; dpkg's own replacing of the binary is
# not covered either way, but every state it can leave is one the next run handles.
take_lock()
{
    if ! command -v flock >/dev/null 2>&1 || ! exec 9> "$LOCK"
    then
        return 0
    fi

    if [ "$mode" = "retry" ]
    then
        flock -n 9 || exit 0
    elif ! flock -w 600 9
    then
        warn "waited 600 s for $LOCK, going on without it"
    fi
}

# Package state decides who restarts Caddy: "unpacked" or "half-configured" means its
# postinst has not run yet and will restart it; "installed" means it already ran.
# Anything else (not installed, config files only, broken) is none of our business; a
# fallback left over from before the package was removed ends with it.
if ! status="$(dpkg-query -W -f='${Status}' caddy 2>/dev/null)"
then
    if [ "$mode" = "retry" ]
    then
        clear_pending
    fi
    exit 0
fi

case "$status" in
    *" ok installed")
        configured=1
        ;;
    *" ok unpacked" | *" ok half-configured")
        configured=0
        ;;
    *)
        if [ "$mode" = "retry" ]
        then
            clear_pending
        fi
        exit 0
        ;;
esac

if [ ! -x "$CADDY_BIN" ]
then
    exit 0
fi

if ! mkdir -p -- "$STATE_DIR"
then
    fail "could not create $STATE_DIR"
fi

take_lock

if [ "$mode" = "retry" ]
then
    # Nothing to do (anymore): switch the timer off.
    if [ ! -f "$PENDING" ]
    then
        stop_retries
        exit 0
    fi

    # In the middle of a dpkg run, or the stock binary is back in place: that is for the
    # dpkg hook, the timer tries again later.
    if [ "$configured" -eq 0 ] || ! has_module
    then
        exit 0
    fi

    retry_pending
    exit 0
fi

if [ "$mode" = "pre" ]
then
    # Only before a run that can replace the binary, and never during a fallback: then
    # the binary is caddy.previous already, or someone replaced it by hand.
    case "${DPKG_HOOK_ACTION:-}" in
        unpack | install) ;;
        *) exit 0 ;;
    esac

    if [ -f "$PENDING" ]
    then
        exit 0
    fi

    if [ -f "$PREVIOUS" ] && cmp -s -- "$CADDY_BIN" "$PREVIOUS"
    then
        exit 0
    fi

    # The stock binary is no fallback.
    if ! has_module
    then
        exit 0
    fi

    if mkdir -p -- "$STATE_DIR" && place_copy "$CADDY_BIN" "$PREVIOUS"
    then
        note "saved $CADDY_BIN ($(binary_version "$CADDY_BIN")) as $PREVIOUS"
    else
        warn "could not save $CADDY_BIN as $PREVIOUS, so there will be nothing to fall back to"
    fi

    exit 0
fi

# The common case after every dpkg run: the module is there, stay silent.
if has_module
then
    if [ -f "$PENDING" ]
    then
        if [ -z "${DPKG_HOOK_ACTION:-}" ]
        then
            # run by hand: retry now
            retry_pending
        elif fallback_intact
        then
            # run by dpkg: the timer retries, dpkg is not held up
            say "still waiting: $(cat -- "$PENDING" 2>/dev/null); $TIMER tries again every 5 minutes, or run $TAG --retry"
            start_retries
        fi
    fi

    exit 0
fi

say "$VERSION: module $MODULE_ID missing from $CADDY_BIN (package state: $status, dpkg action: ${DPKG_HOOK_ACTION:-unknown}), adding $PLUGIN_PACKAGE"

attempt=1
while :
do
    if build_with_module "$CADDY_BIN" "$ADD_PACKAGE_TIMEOUT"
    then
        install_built
        exit 0
    fi

    rm -rf -- "$WORK"
    note "attempt $attempt of $ADD_PACKAGE_ATTEMPTS failed: $reason"

    if [ "$attempt" -ge "$ADD_PACKAGE_ATTEMPTS" ]
    then
        break
    fi

    say "attempt $attempt of $ADD_PACKAGE_ATTEMPTS failed, trying again in $ATTEMPT_PAUSE s"
    sleep "$ATTEMPT_PAUSE"
    attempt=$((attempt + 1))
done

fall_back "$reason (attempt $attempt of $ADD_PACKAGE_ATTEMPTS)"
exit 0
